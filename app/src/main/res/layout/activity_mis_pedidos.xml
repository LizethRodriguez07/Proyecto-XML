<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_negro"
    tools:context=".MisPedidosActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarPedidos"
        style="@style/Style.ToolbarApp"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/oro"
        app:title="@string/mis_pedidos_titulo"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Estado vacío -->
    <ScrollView
        android:id="@+id/scrollPedidos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarPedidos">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/Style.Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        app:cardBackgroundColor="@color/surface_alta"
                        app:cardCornerRadius="48dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/imgPedidos"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/mis_pedidos_titulo"
                            android:tint="@color/oro"
                            app:srcCompat="@drawable/ic_nav_pedidos" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvTituloPedidos"
                        style="@style/TextAppearance.TituloPantalla"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:letterSpacing="0.03"
                        android:text="@string/mis_pedidos_vacio_titulo" />

                    <TextView
                        android:id="@+id/tvMensajePedidos"
                        style="@style/TextAppearance.Subtitulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:lineSpacingExtra="5dp"
                        android:text="@string/mis_pedidos_vacio" />

                    <View
                        android:layout_width="64dp"
                        android:layout_height="2dp"
                        android:layout_marginTop="24dp"
                        android:background="@color/oro" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVolverPedidos"
                        style="@style/Style.BotonDorado"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="28dp"
                        android:letterSpacing="0.08"
                        android:text="@string/btn_volver" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- Lista de pedidos (cuando hay) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPedidos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarPedidos"
        tools:listitem="@layout/item_rv_pedidos" />

</androidx.constraintlayout.widget.ConstraintLayout>