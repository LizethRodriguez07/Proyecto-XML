<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_dark_bg"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTituloDialogo"
        style="@style/TextAppearance.TituloSeccion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Título"
        android:textColor="@color/oro"
        android:textSize="19sp" />

    <TextView
        android:id="@+id/tvMensajeDialogo"
        style="@style/TextAppearance.Subtitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="6dp"
        android:text="Mensaje" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCerrarDialogo"
        style="@style/Style.BotonDorado"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:text="@string/dialog_entendido"
        android:textSize="15sp" />

</LinearLayout>