<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_negro"
    android:padding="24dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="24dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/btnVolverTienda"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Icono de éxito -->
            <ImageView
                android:id="@+id/imgSuccess"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="64dp"
                android:contentDescription="Pedido exitoso"
                app:srcCompat="@drawable/ic_check_circulo" />

            <TextView
                android:id="@+id/tvGracias"
                style="@style/TextAppearance.TituloPantalla"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/pedido_exitoso"
                android:textColor="@color/oro"
                android:textSize="26sp"
                android:letterSpacing="0.03" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Style.Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginHorizontal="4dp"
                app:cardCornerRadius="20dp"
                app:strokeColor="@color/oro_translucido">

                <TextView
                    android:id="@+id/tvSubtitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp"
                    android:text="@string/pedido_mensaje"
                    android:textColor="@color/texto_secundario"
                    android:textSize="15sp"
                    android:lineSpacingExtra="6dp"
                    android:gravity="center" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVolverTienda"
        style="@style/Style.BotonDorado"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/fin_pedido_volver"
        android:letterSpacing="0.08"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>