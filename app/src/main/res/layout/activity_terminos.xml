<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_negro"
    tools:context=".TerminosCondicionesActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarTerminos"
        style="@style/Style.ToolbarApp"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:subtitle="@string/terminos_subtitulo"
        app:title="@string/terminos_barra" />

    <ScrollView
        android:id="@+id/scrollTerminos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/containerBotones"
        app:layout_constraintTop_toBottomOf="@id/toolbarTerminos">

        <com.google.android.material.card.MaterialCardView
            style="@style/Style.Tarjeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tvTerminosTitulo"
                    style="@style/TextAppearance.TituloMarca"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/terminos_titulo"
                    android:textSize="20sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/borde" />

                <TextView
                    android:id="@+id/tvTerminosContenido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:lineSpacingExtra="7dp"
                    android:textColor="@color/texto_secundario"
                    android:textSize="14sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>

    <LinearLayout
        android:id="@+id/containerBotones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_negro"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAceptarTerminos"
            style="@style/Style.BotonDorado"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/aceptar_terminos"
            android:letterSpacing="0.08" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarTerminos"
            style="@style/Style.BotonContorno"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:text="@string/cancelar" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>