<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#1A1A1A"
    app:strokeWidth="1dp"
    app:strokeColor="#33FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Contenedor de la Imagen con esquinas redondeadas -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imageView3"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedSquare"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:src="@drawable/niked" />

        <!-- Nombre del Producto -->
        <TextView
            android:id="@+id/nomproducto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="sans-serif-black"
            android:text="NIKE AIR TRAINER"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/imageView3"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Descripción corta con límite de líneas -->
        <TextView
            android:id="@+id/nomdescripcion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Color: Blanco/Verde"
            android:textColor="#BDBDBD"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/nomproducto"
            app:layout_constraintTop_toBottomOf="@+id/nomproducto" />

        <!-- Etiqueta de Talla -->
        <TextView
            android:id="@+id/tvLabelTalla"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Talla:"
            android:textColor="#BDBDBD"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@+id/nomproducto"
            app:layout_constraintTop_toBottomOf="@+id/nomdescripcion" />

        <!-- Spinner de Tallas -->
        <Spinner
            android:id="@+id/spTallas"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#D4AF37"
            app:layout_constraintBottom_toBottomOf="@+id/tvLabelTalla"
            app:layout_constraintStart_toEndOf="@+id/tvLabelTalla"
            app:layout_constraintTop_toTopOf="@+id/tvLabelTalla" />

        <!-- Precio -->
        <TextView
            android:id="@+id/nomprecio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/nomprecio"
            android:textColor="#D4AF37"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/nomproducto"
            app:layout_constraintTop_toBottomOf="@+id/spTallas" />

        <!-- Botón de añadir en un Checkbox -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_item"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Añadir"
            android:textColor="#007BFF"
            android:textSize="13sp"
            android:textStyle="bold"
            app:icon="@android:drawable/ic_input_add"
            app:iconTint="#D4AF37"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>