<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Style.Tarjeta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Imagen del producto -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imageView3"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedSquare"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/niked" />

        <!-- Nombre del producto -->
        <TextView
            android:id="@+id/nomproducto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-condensed-bold"
            android:text="NIKE AIR TRAINER"
            android:textColor="@color/texto_principal"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/imageView3"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Marca -->
        <TextView
            android:id="@+id/tvMarca"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Nike"
            android:textColor="@color/oro"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/nomproducto"
            app:layout_constraintTop_toBottomOf="@+id/nomproducto" />

        <!-- Descripción -->
        <TextView
            android:id="@+id/nomdescripcion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Color: Blanco/Verde"
            android:textColor="@color/texto_terciario"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/nomproducto"
            app:layout_constraintTop_toBottomOf="@+id/tvMarca" />

        <!-- Talla -->
        <TextView
            android:id="@+id/tvLabelTalla"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Talla:"
            android:textColor="@color/texto_secundario"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@+id/nomproducto"
            app:layout_constraintTop_toBottomOf="@+id/nomdescripcion" />

        <Spinner
            android:id="@+id/spTallas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_spinner_talla"
            android:gravity="center"
            android:minWidth="64dp"
            android:textColor="@color/texto_principal"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@+id/tvLabelTalla"
            app:layout_constraintStart_toEndOf="@+id/tvLabelTalla"
            app:layout_constraintTop_toTopOf="@+id/tvLabelTalla" />

        <!-- Precio -->
        <TextView
            android:id="@+id/nomprecio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="$380.000"
            android:textColor="@color/oro"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/nomproducto"
            app:layout_constraintTop_toBottomOf="@+id/tvLabelTalla" />

        <!-- Botón añadir / quitar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_item"
            style="@style/Style.BotonAccion"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Añadir"
            android:letterSpacing="0.04"
            app:icon="@android:drawable/ic_input_add"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconTint="@color/black"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>