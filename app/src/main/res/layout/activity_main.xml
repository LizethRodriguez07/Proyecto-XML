<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_negro">

        <!-- Encabezado -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="0dp"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                style="@style/Style.ToolbarApp"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:navigationIconTint="@color/oro"
                app:subtitle="@string/header_subtitulo"
                app:title="@string/header_titulo" />

        </com.google.android.material.appbar.AppBarLayout>

        <!-- Búsqueda y filtros -->
        <LinearLayout
            android:id="@+id/filtrosContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tlBuscar"
                style="@style/Style.Buscador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/buscar_hint"
                app:endIconMode="clear_text"
                app:startIconDrawable="@drawable/ic_buscar">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBuscar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/texto_principal" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupMarca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                app:chipSpacingHorizontal="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTodos"
                    style="@style/Style.ChipMarca"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/chip_todos" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipNike"
                    style="@style/Style.ChipMarca"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chip_nike" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAdidas"
                    style="@style/Style.ChipMarca"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chip_adidas" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPuma"
                    style="@style/Style.ChipMarca"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chip_puma" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipNewBalance"
                    style="@style/Style.ChipMarca"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chip_new_balance" />

            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <!-- Lista de productos -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_productos"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:padding="12dp"
            app:layout_constraintBottom_toTopOf="@+id/btn_ver_carrito"
            app:layout_constraintTop_toBottomOf="@id/filtrosContainer"
            tools:listitem="@layout/item_rv_productos" />

        <!-- Mensaje sin resultados -->
        <TextView
            android:id="@+id/tvSinResultados"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/sin_resultados"
            android:textColor="@color/texto_terciario"
            android:textSize="15sp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@+id/btn_ver_carrito"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/filtrosContainer" />

        <!-- Botón ver carrito -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ver_carrito"
            style="@style/Style.BotonDorado"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_margin="16dp"
            android:text="@string/ver_mi_carrito"
            app:icon="@drawable/ic_nav_carrito"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/black"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface_alta"
        app:headerLayout="@layout/header_drawer"
        app:itemIconTint="@color/drawer_item_color"
        app:itemTextColor="@color/drawer_item_color"
        app:itemShapeAppearance="@style/ShapeAppearances.NavItem"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>