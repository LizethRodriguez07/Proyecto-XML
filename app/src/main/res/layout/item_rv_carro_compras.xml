<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Style.Tarjeta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Imagen -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imageView2"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundedSquare"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/niked" />

        <ImageButton
            android:id="@+id/btnEliminar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@android:drawable/ic_menu_delete"
            app:tint="@color/error"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Nombre -->
        <TextView
            android:id="@+id/nomproducto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Nombre del Producto"
            android:textColor="@color/texto_principal"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/btnEliminar"
            app:layout_constraintStart_toEndOf="@+id/imageView2"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Marca -->
        <TextView
            android:id="@+id/tvMarca"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Marca: Nike"
            android:textColor="@color/oro"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/btnEliminar"
            app:layout_constraintStart_toStartOf="@+id/nomproducto"
            app:layout_constraintTop_toBottomOf="@+id/nomproducto" />

        <!-- Descripción -->
        <TextView
            android:id="@+id/nomdescripcion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Descripción corta"
            android:textColor="@color/texto_terciario"
            android:textSize="11sp"
            app:layout_constraintEnd_toStartOf="@+id/btnEliminar"
            app:layout_constraintStart_toStartOf="@+id/nomproducto"
            app:layout_constraintTop_toBottomOf="@+id/tvMarca" />

        <!-- Talla -->
        <TextView
            android:id="@+id/tvLabelTalla"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Talla:"
            android:textColor="@color/texto_secundario"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/nomproducto"
            app:layout_constraintTop_toBottomOf="@+id/nomdescripcion"
            app:layout_constraintVertical_bias="0.3" />

        <Spinner
            android:id="@+id/spTallaCarro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_spinner_talla"
            android:gravity="center"
            android:minWidth="60dp"
            android:textColor="@color/texto_principal"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@+id/tvLabelTalla"
            app:layout_constraintStart_toEndOf="@+id/tvLabelTalla"
            app:layout_constraintTop_toTopOf="@+id/tvLabelTalla" />

        <!-- Columna precio + cantidad -->
        <LinearLayout
            android:id="@+id/llPrecioCantidad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Precio unitario -->
            <TextView
                android:id="@+id/tvPrecioUnitario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Precio: $0.0"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp" />

            <!-- Cantidad -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btnMenos"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_spinner_talla"
                    app:srcCompat="@drawable/ic_cantidad_menos"
                    app:tint="@color/oro"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvCantidad"
                    android:layout_width="42dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/texto_principal"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnMas"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_spinner_talla"
                    app:srcCompat="@drawable/ic_cantidad_mas"
                    app:tint="@color/oro"
                    tools:ignore="ContentDescription" />
            </LinearLayout>

            <!-- Subtotal -->
            <TextView
                android:id="@+id/nomprecio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Subtotal: $0.0"
                android:textColor="@color/oro"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Subtotal: $760.000" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>